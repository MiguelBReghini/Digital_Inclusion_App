using System.Reflection.Metadata.Ecma335;
using System.Text.RegularExpressions;
using System.Threading;

namespace DigitalInclusionApp
{
    public partial class MainForm : Form
    {
        Thread? t1;
        public MainForm()    },
        {
            InitializeComponent();
        }

        private void btnAprender_Click(object sender, EventArgs e)
        {
            Close();
            t1 = new Thread(openLearning);
            t1.SetApartmentState(ApartmentState.STA);
            t1.Start();
        }

        private void btnExercicios_Click(object sender, EventArgs e)
        {
            this.Close();
            t1 = new Thread(openExercises);
            t1.SetApartmentState(ApartmentState.STA);
            t1.Start();
        }

        private void btnCreditos_Click(object sender, EventArgs e)
        {
            this.Close();
            t1 = new Thread(openCredits);
            t1.SetApartmentState(ApartmentState.STA);
            t1.Start();
        }

        private void btnSair_Click(object sender, EventArgs e)
        {
            this.Close();
            
        }

        public void openLearning()
        {
            Application.Run(new Learning());
            return;
        }
        public void openExercises()
        {
            Application.Run(new Exercises());
            return;
        }
        public void openCredits()
        {
            Application.Run(new Credits());
            return;
        }

    }
}

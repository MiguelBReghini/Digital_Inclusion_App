<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DigitalInclusionApp</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_Learning\**" />
    <EmbeddedResource Remove="_Learning\**" />
    <None Remove="_Learning\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Learning\Informatics\Basic\BasicPage3.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Learning\Informatics\Basic\BasicPage2.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Learning\Informatics\Basic\BasicPage1.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Learning\Security\Scam\ScamPage3.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Learning\Security\Scam\ScamPage2.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Learning\Security\Scam\ScamPage1.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>